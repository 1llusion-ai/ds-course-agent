# RAG System Environment Configuration
# Copy this file to .env and fill in your values

# === Datalab API (Marker 云端解析，可选) ===
DATALAB_API_KEY=

# === Embedding API Configuration ===
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# === Chat Model Configuration ===
# true: use OpenAI-compatible remote API; false: use local Ollama
USE_REMOTE_LLM=true
REMOTE_MODEL_NAME=Qwen/Qwen3-8B

# Local Ollama fallback when USE_REMOTE_LLM=false
CHAT_MODEL=qwen3:8b
CHAT_BASE_URL=http://localhost:11434

# === Course Configuration ===
COURSE_NAME=数据科学导论
COURSE_DESCRIPTION=概念答疑、课程资料问答、学习建议
COURSE_COLLECTION_NAME=

# === Storage Paths (relative to project root) ===
CHROMA_PERSIST_DIR=var/chroma_db
CHAT_HISTORY_DIR=var/chat_history
MD5_RECORD_FILE=md5.text

# === Vector Store Configuration ===
COLLECTION_NAME=rag_knowledge_base
SIMILARITY_TOP_K=3

# === Text Splitter Configuration ===
CHUNK_SIZE=1300
CHUNK_OVERLAP=300
MAX_SPLIT_CHAR_NUMBER=1500

# === Session Configuration ===
DEFAULT_SESSION_ID=user_001

# === Logging ===
# DEBUG / INFO / WARNING / ERROR，线上建议 INFO，调试用 DEBUG
LOG_LEVEL=INFO

# === Reranker Configuration ===
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=20
RERANK_BATCH_SIZE=8
RERANK_DEVICE=auto

# === Runtime Latency Optimization ===
KNOWLEDGE_MAPPER_EMBEDDING_CACHE=data/knowledge_graph_embeddings.json
CHAT_MAX_TOKENS=512
CHAT_TIMEOUT_SECONDS=45
CHAT_MAX_RETRIES=2
CHAT_DISABLE_THINKING=true
CHAT_SYSTEM_SUFFIX=/no_think
