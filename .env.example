# RAG System Environment Configuration
# Copy this file to .env and fill in your values

# === Datalab API (Marker 云端解析，可选) ===
DATALAB_API_KEY=

# === Embedding API Configuration ===
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_TIMEOUT_SECONDS=8
EMBEDDING_MAX_RETRIES=0
EMBEDDING_QUERY_CACHE_SIZE=512
EMBEDDING_CIRCUIT_BREAKER_SECONDS=60

# === Chat Model Configuration ===
# true: use OpenAI-compatible remote API; false: use local Ollama
USE_REMOTE_LLM=true
REMOTE_MODEL_NAME=Qwen/Qwen3-8B

# Local Ollama fallback when USE_REMOTE_LLM=false
CHAT_MODEL=qwen3:8b
CHAT_BASE_URL=http://localhost:11434

# Learning semantic router. Leave ROUTER_MODEL_NAME empty to reuse the active
# remote/local chat model selected above.
ROUTER_MODEL_NAME=
ROUTER_MAX_TOKENS=128
ROUTER_TIMEOUT_SECONDS=5
ROUTER_MAX_RETRIES=0
ROUTER_RECENT_CONTEXT_MAX_CHARS=1200
ROUTER_MIN_CONFIDENCE=0.65

# === Course Configuration ===
COURSE_NAME=数据科学导论
COURSE_DESCRIPTION=概念答疑、课程资料问答、学习建议
COURSE_COLLECTION_NAME=

# === Storage Paths (relative to project root) ===
CHROMA_PERSIST_DIR=var/chroma_db
CHAT_HISTORY_DIR=var/chat_history
MD5_RECORD_FILE=md5.text


# === Authentication / CORS ===
# Set a long random value in production, for example: openssl rand -hex 32
AUTH_SECRET_KEY=
AUTH_SESSION_TTL_HOURS=12
# Set true only behind HTTPS. Local development over http should remain false.
AUTH_COOKIE_SECURE=false
AUTH_DB_PATH=var/auth.db
# Comma-separated allowed browser origins, e.g. https://course.example.edu
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:5175,http://localhost:5176

# === Vector Store Configuration ===
COLLECTION_NAME=rag_knowledge_base
SIMILARITY_TOP_K=3

# === Text Splitter Configuration ===
CHUNK_SIZE=1300
CHUNK_OVERLAP=300
MAX_SPLIT_CHAR_NUMBER=1500

# === Session Configuration ===
DEFAULT_SESSION_ID=user_001

# === Logging ===
# DEBUG / INFO / WARNING / ERROR，线上建议 INFO，调试用 DEBUG
LOG_LEVEL=INFO

# === Reranker Configuration ===
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=20
RERANK_BATCH_SIZE=8
RERANK_DEVICE=auto

# === Benchmark LLM Generation (optional) ===
# Used by benchmarks/profile_eval_generator.py. Keep real keys in .env only.
PROFILE_EVAL_API_KEY=
PROFILE_EVAL_BASE_URL=http://model.mify.ai.srv/v1
PROFILE_EVAL_MODEL=xiaomi/mimo-v2.5-pro

# === Runtime Latency Optimization ===
KNOWLEDGE_MAPPER_EMBEDDING_CACHE=data/knowledge_graph_embeddings.json
CHAT_MAX_TOKENS=512
CHAT_TIMEOUT_SECONDS=45
CHAT_MAX_RETRIES=2
CHAT_DISABLE_THINKING=true
CHAT_SYSTEM_SUFFIX=/no_think
QUERY_CACHE_ENABLED=true
QUERY_CACHE_SIZE=512

# === Context / tool-result governance ===
CONTEXT_WINDOW_TOKENS=8192
CONTEXT_BUDGET_RATIO=0.70
CONTEXT_LARGE_MESSAGE_TOKENS=2048
# Optional; default false keeps context compaction deterministic and offline.
CONTEXT_SEMANTIC_SUMMARY_ENABLED=false
CONTEXT_SEMANTIC_SUMMARY_TIMEOUT_SECONDS=3
RAG_CONTEXT_TRIM_ENABLED=true
RAG_CONTEXT_MAX_CHARS=4500
RAG_CONTEXT_DOC_MAX_CHARS=1500
RAG_ANSWER_MAX_TOKENS=768
RAG_ANSWER_TIMEOUT_SECONDS=30
RAG_ANSWER_CACHE_ENABLED=true
RAG_ANSWER_CACHE_TTL_SECONDS=900
RAG_ANSWER_CACHE_SIZE=128
RAG_RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=5
RAG_RETRIEVAL_CACHE_ENABLED=true
RAG_RETRIEVAL_CACHE_TTL_SECONDS=600
RAG_RETRIEVAL_CACHE_SIZE=128
TOOL_RESULT_ARTIFACTS_ENABLED=true
TOOL_RESULT_ARTIFACT_DIR=var/artifacts/tool_results
TOOL_RESULT_INLINE_MAX_CHARS=3000

# === Product scope guard ===
# Keep the course assistant focused on learning / data-science / programming / research tasks.
SCOPE_GUARD_ENABLED=true

# === Explicit Web Search (optional, user-triggered) ===
# Enable only if you want the frontend's “联网搜索” switch to call external search APIs.
WEB_SEARCH_ENABLED=false
# Supported: tavily, serper, brave, duckduckgo (duckduckgo requires optional ddgs package)
WEB_SEARCH_PROVIDER=tavily
# Generic key used by tavily/serper/brave; provider-specific env vars also work: TAVILY_API_KEY, SERPER_API_KEY, BRAVE_API_KEY
WEB_SEARCH_API_KEY=
WEB_SEARCH_TOP_K=0
WEB_SEARCH_MIN_TOP_K=8
WEB_SEARCH_MAX_TOP_K=16
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_CONTEXT_MAX_CHARS=2500
WEB_SEARCH_SNIPPET_MAX_CHARS=300
# Keep explicit web search scoped to learning/teaching/AI/data-science/project research.
WEB_SEARCH_TEACHING_SCOPE_ENABLED=true

# === Deep Web Fetch (optional, used after explicit web search) ===
# When enabled, the backend reads the top web-search result pages and compresses the text.
WEB_FETCH_ENABLED=false
# Adaptive mode treats WEB_FETCH_TOP_N as an upper cap: ordinary questions read 1 page,
# project/list questions read 2, ambiguous/latest/compare questions read 3, high-stakes learning topics read up to 4.
# 0 = no explicit cap (still bounded by the internal safety maximum and adaptive target).
WEB_FETCH_ADAPTIVE_ENABLED=true
WEB_FETCH_TOP_N=4
WEB_FETCH_MAX_ATTEMPTS=10
WEB_FETCH_MAX_WORKERS=4
# 0 = use built-in dynamic budget (about 6s to 12s by question type).
WEB_FETCH_TOTAL_TIMEOUT_SECONDS=0
WEB_FETCH_TIMEOUT_SECONDS=6
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_MAX_CHARS_PER_PAGE=3500
WEB_FETCH_CONTEXT_MAX_CHARS=4500
WEB_FETCH_USE_JINA_READER=true

# === Python Code Execution Sandbox ===
# Explicit "run/execute" requests are executed only through this sandbox path.
# Default is fail-closed Docker: if Docker is unavailable, code is not run.
PYTHON_EXEC_ENABLED=true
PYTHON_EXEC_BACKEND=docker
PYTHON_EXEC_ALLOW_HOST_FALLBACK=false
PYTHON_EXEC_DOCKER_IMAGE=python:3.11-slim
# Cache `docker info` availability checks on the hot path; set 0 to probe every run.
PYTHON_EXEC_DOCKER_AVAILABILITY_TTL_SECONDS=5
PYTHON_EXEC_TIMEOUT_SECONDS=5
# Per backend process. When full, requests fail closed with sandbox_busy=true.
PYTHON_EXEC_MAX_CONCURRENT=2
# 0 = fail fast; use a small value (for example 0.1) only if short waiting is acceptable.
PYTHON_EXEC_BUSY_TIMEOUT_SECONDS=0
PYTHON_EXEC_MAX_OUTPUT_CHARS=4000
PYTHON_EXEC_MEMORY_MB=256
PYTHON_EXEC_CPUS=0.5
PYTHON_EXEC_TMPFS_MB=64
PYTHON_EXEC_PIDS_LIMIT=64
