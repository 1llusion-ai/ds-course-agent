# Environment and secrets
.env
.env.*
!.env.example

# Local agent / editor metadata
.claude/
.vscode/
.idea/
.agents/
.aris/
# NOTE: CLAUDE.md and AGENTS.md are intentionally TRACKED (shared engineering
# constitution). Do not re-add CLAUDE.md here.

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
pytest_cache/
pytest_tmp/
session_smoke_tmp/
tests_tmp_manual/
manual_*/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# Runtime state
chat_history/
chroma_db/
utils/chroma_db/
logs/
*.log
*.pid
*.sqlite3
*.db

# Frontend build artifacts
web/node_modules/
web/dist/

# Temporary / debug files
tmp_*.json
temp_response.txt
artifacts/
data/cache/

# Generated/precomputed data (can be regenerated)
data/knowledge_graph_embeddings.json

# Generated evaluation outputs
eval/reports/*.json
eval/reports/*.log
eval/reports/*.pid
!eval/reports/.gitkeep

# Raw course assets that are large or may have copyright restrictions
data/*.pdf
data/*.docx
data/*.pptx
data/*.ppt

# OS files
.DS_Store
Thumbs.db

#gsd
.planning/

# Technical documentation (local only)
docs/technical_documentation.md

.omx/

var/chat_history/*
var/chroma_db/*
var/logs/*
var/artifacts/*
var/cache/*
!var/**/.gitkeep
